    {
      "id": 10,
      "type": "bargauge",
      "title": "Host data volume used % — macOS nodes  (80% = Customer X's example threshold)",
      "description": "Metrics: `node_filesystem_size_bytes` and `node_filesystem_avail_bytes` (gauges), job `orka-nodes`.\nSelector: `mountpoint=\"/System/Volumes/Data\", fstype=\"apfs\"` — the writable APFS data volume on the macOS hosts, where VM disk images and cached images live.\nPromQL: `100 * (1 - avail / size)`, each side wrapped in `max by (instance)`, joined to `node_uname_info` for the node name.\nThresholds: yellow 70, red 80 (Customer X's ask D3 cites 80% as an example). Linux nodes do not have this mountpoint and are excluded.\nNote: this is host free space. It does NOT show how much space the VMs have been allocated (see final text panel).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * (1 - max by (instance) (node_filesystem_avail_bytes{mountpoint=\"/System/Volumes/Data\",fstype=\"apfs\"}) / max by (instance) (node_filesystem_size_bytes{mountpoint=\"/System/Volumes/Data\",fstype=\"apfs\"}))) * on (instance) group_left (nodename) node_uname_info",
          "legendFormat": "{{nodename}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Host data volume free GiB — macOS nodes",
      "description": "Metric: `node_filesystem_avail_bytes`, same selector as the panel to the left, divided by 1024^3.\nMeaning: absolute headroom. Red below 50 GiB, yellow below 100 GiB (illustrative values, edit to taste).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max by (instance) (node_filesystem_avail_bytes{mountpoint=\"/System/Volumes/Data\",fstype=\"apfs\"}) / 1024 / 1024 / 1024) * on (instance) group_left (nodename) node_uname_info",
          "legendFormat": "{{nodename}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
