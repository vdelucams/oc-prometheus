    {
      "id": 7,
      "type": "bargauge",
      "title": "CPU usage % — by node",
      "description": "Metric: `node_cpu_seconds_total` (counter) with `mode=\"idle\"`, job `orka-nodes`.\nPromQL: `100 - avg by (instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100`, joined to `node_uname_info` on `instance` to show the node name.\nMeaning: host CPU busy %. Supports O3 (node dashboards).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)) * on (instance) group_left (nodename) node_uname_info",
          "legendFormat": "{{nodename}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
