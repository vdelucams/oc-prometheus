    {
      "id": 13,
      "type": "bargauge",
      "title": "NFS image-storage mount used %",
      "description": "Metrics: `node_filesystem_size_bytes`, `node_filesystem_avail_bytes`, job `orka-nodes`, selector `fstype=\"nfs\"` (`/Users/devadmin/mnt` on macOS nodes, `/var/mnt` on the Linux node that mounts it).\nPromQL: `100 * (1 - avail/size)` grouped by instance and mountpoint.\nMeaning: capacity of the shared NFS export used for image storage, as seen from each node. All nodes see the same export, so the values should agree; a node that disagrees is worth checking.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - max by (instance, mountpoint) (node_filesystem_avail_bytes{fstype=\"nfs\"}) / max by (instance, mountpoint) (node_filesystem_size_bytes{fstype=\"nfs\"}))",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
