          "expr": "((1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|aufs|squashfs|nfs.*\", mountpoint=\"/\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|aufs|squashfs|nfs.*\", mountpoint=\"/\"}) * 100) * on (instance) group_left (nodename) node_uname_info",
          "legendFormat": "{{nodename}}",
