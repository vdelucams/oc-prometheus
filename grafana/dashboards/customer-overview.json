    {
      "type": "table",
      "title": "Nodes at a Glance",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 54
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"orka-nodes\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "(100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)) * on (instance) group_left (nodename) node_uname_info",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "(avg by (instance) (node_load1)) * on (instance) group_left (nodename) node_uname_info",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "(sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|utun.*|awdl.*|llw.*|bridge.*\"}[5m])) * 8) * on (instance) group_left (nodename) node_uname_info",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "(sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo|utun.*|awdl.*|llw.*|bridge.*\"}[5m])) * 8) * on (instance) group_left (nodename) node_uname_info",
          "format": "table",
          "instant": true,
          "refId": "E"
        },
        {
          "expr": "(time() - avg by (instance) (node_boot_time_seconds)) * on (instance) group_left (nodename) node_uname_info",
          "format": "table",
          "instant": true,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "Up",
              "Value #B": "CPU %",
              "Value #C": "Load (1m)",
              "Value #D": "Net In",
              "Value #E": "Net Out",
              "Value #F": "Uptime",
              "nodename": "Node",
              "instance": "IP"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 70
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Load (1m)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Net In"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Net Out"
            },
            "properties": [
              {
                "id": "unit",
