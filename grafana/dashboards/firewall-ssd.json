{
 "uid": "orka-firewall-ssd",
 "title": "Firewall \u2014 Cisco ASA/ASAv (SNMP)",
 "tags": [
  "orka",
  "firewall",
  "ssd-labs"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 4,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "description": "Cisco ASA/ASAv in front of the cluster, polled over SNMPv3 by snmp-exporter-ssd (README, Firewall metrics). OIDs verified on an ASAv in October 2026; re-check on other models.",
 "panels": [
  {
   "id": 16,
   "type": "stat",
   "title": "Licensed throughput (Mbit/s)",
   "description": "Editable at the top of the dashboard. ASAv5 = 100, ASAv10 = 1000, ASAv30 = 2000 (Cisco published licences).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "vector($licence_mbps)",
     "legendFormat": "licence"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 17,
   "type": "gauge",
   "title": "Load now, % of licence (5 min)",
   "description": "Interface $wan_if. Guide: investigate at 75% sustained, act at 90%+ (rate-limited above the licence).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "100 * rate(ifHCInOctets{job=\"macstadium-firewall-ssd\",ifName=\"$wan_if\"}[5m]) * 8 / ($licence_mbps * 1e6)",
     "legendFormat": "in"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "100 * rate(ifHCOutOctets{job=\"macstadium-firewall-ssd\",ifName=\"$wan_if\"}[5m]) * 8 / ($licence_mbps * 1e6)",
     "legendFormat": "out"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 120,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 60
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 18,
   "type": "stat",
   "title": "P95 in, % of licence (7d)",
   "description": "95th percentile of 5-minute throughput over the data available (history starts when this stack first scraped the firewall, 8 Oct 2026). Not necessarily MacStadium's P95 method.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 3,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "100 * quantile_over_time(0.95, (rate(ifHCInOctets{job=\"macstadium-firewall-ssd\",ifName=\"$wan_if\"}[5m]) * 8)[7d:5m]) / ($licence_mbps * 1e6)",
