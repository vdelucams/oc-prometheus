# oc-prometheus configuration — copy to .env and edit for YOUR cluster.
#   cp env.example .env && docker compose up -d
# On `docker compose up`, prometheus.yml is generated from these values,
# so the IP plan below is the ONLY thing most customers need to change.

# --- Orka IP plan (standard plan shown; replace with your own) ---
# Host that serves the Orka operator metrics on :8080
ORKA_ENDPOINT=10.221.188.20
# Comma-separated list of Orka node exporters (host:9100)
ORKA_NODE_EXPORTERS=10.221.188.31:9100,10.221.188.32:9100,10.221.188.33:9100,10.221.188.34:9100,10.221.188.35:9100,10.221.188.36:9100,10.221.188.37:9100,10.221.188.38:9100,10.221.188.39:9100

# --- Cluster identity (shown in the dashboard header) ---
CLUSTER_NAME=ORKA10000000
ORKA_VERSION=3.6.2
TENANT=MS00000000
SITE=las1

# --- Scrape interval (optional; default 30s) ---
# SCRAPE_INTERVAL=30s

# --- Optional: VM slot capacity dashboard (needs Kubernetes access) ---
# Counts Apple silicon VM slots (apple.com/vm) per node and Orka namespace
# from kube-state-metrics. Off by default. To enable:
#   1. Export a single-cluster kubeconfig (read-only use: port-forward only):
#        mkdir -p secrets && kubectl config view --minify --flatten \
#          --context <your-context> > secrets/kubeconfig && chmod 600 secrets/kubeconfig
#   2. Uncomment the lines below and run `docker compose up -d`.
# COMPOSE_PROFILES=ksm-tunnel
# KSM_TARGET=ksm-tunnel:8080
# KSM_KUBECONFIG=./secrets/kubeconfig
# KSM_NAMESPACE=monitoring
# KSM_SERVICE=kps-kube-state-metrics
# KSM_PORT=8080
# If kube-state-metrics is directly reachable, skip the tunnel: leave
# COMPOSE_PROFILES unset and set KSM_TARGET=<host>:<port>.

# --- Optional: firewall metrics over SNMPv3 (Cisco ASA / ASAv) ---
# Polls the firewall's INSIDE address with the snmp-exporter-ssd service. First
# create an SNMPv3 user on the firewall (group, then user, then host with "poll"
# for this machine's address) — see README "Firewall metrics (SNMP)". To enable:
#   1. Fill in the values below and uncomment them.
#   2. Add snmp-ssd to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=ksm-tunnel,snmp-ssd).
#   3. docker compose up -d
# FW_SNMP_TARGET=<firewall-inside-ip>
# FW_NAME=<firewall-name>
# FW_SNMP_USER=<username>
# FW_SNMP_AUTH_PASSWORD=
# FW_SNMP_PRIV_PASSWORD=

# --- Grafana admin credentials ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
